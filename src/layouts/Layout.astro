---
import '@/styles/global.css';
import GlobalInquiryModal from '@/components/GlobalInquiryModal';

export interface Props {
  title?: string;
  description?: string;
  /** Drop the footer for immersive, viewport-height pages (e.g. the PDF viewer). */
  hideFooter?: boolean;
}

const {
  title = 'Scirocco Studio - Design, Procurement, Craftsmanship',
  description = 'We specialize in global sourcing and bespoke production, collaborating with manufacturers and artisans across Italy, Europe, and Asia.',
  hideFooter = false
} = Astro.props;

// Canonical URL
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og-image.png', Astro.site);
---

<!DOCTYPE html>
<html lang="en" class="overflow-x-hidden">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>

  <!-- Canonical URL -->
  <link rel="canonical" href={canonicalURL}>

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImageURL}>

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content={canonicalURL}>
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImageURL}>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <!-- DNS Prefetch for external resources -->
  <link rel="dns-prefetch" href="https://fonts.googleapis.com">
  <link rel="dns-prefetch" href="https://fonts.gstatic.com">

  <!-- Preconnect to critical origins -->
  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <!-- Google Fonts with optimized loading -->
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Lora:ital,wght@0,400;0,700;1,400&display=swap">
  <link id="google-fonts" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Lora:ital,wght@0,400;0,700;1,400&display=swap" media="print">
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Lora:ital,wght@0,400;0,700;1,400&display=swap">
  </noscript>

  <!-- Preload critical hero images for scroll-locked animation -->
  <link rel="preload" as="image" href="/hero-bg-initial.png" fetchpriority="high">
  <link rel="preload" as="image" href="/hero-bg-final.png">
  <link rel="preload" as="image" href="/Scirocco-landinglogo.png" fetchpriority="high">

  <title>{title}</title>

  <!-- Hand-written critical CSS. Prevents horizontal scroll and layout shift. -->
  <style is:inline>
    /* Prevent horizontal scroll and layout shifts */
    html, body {
      overflow-x: hidden;
      width: 100%;
      position: relative;
      margin: 0;
      padding: 0;
    }

    body {
      touch-action: manipulation;
      overscroll-behavior-x: none;
      min-height: 100vh;
    }

    /* Prevent layout shift for images */
    img {
      content-visibility: auto;
    }

    /* Optimize rendering */
    * {
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
  </style>
</head>
<body class="bg-scirocco-ivory text-scirocco-noam min-h-screen overflow-x-hidden w-full">
  <a href="#main" class="skip-link">Skip to content</a>
  <!-- Navigation -->
  <nav id="navbar" class="fixed top-0 left-0 right-0 z-[100] transition-all duration-700 opacity-0 invisible pointer-events-none w-full overflow-hidden" aria-label="Main navigation">
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/20 to-transparent backdrop-blur-md border-b border-white/10"></div>

    <div class="relative px-4 md:px-8 py-4 md:py-5 flex justify-between items-center w-full">
      <a href="/" class="flex items-center space-x-3 group relative" aria-label="Scirocco Studio Home">
        <div class="relative">
          <img
            src="/Scirocco-landinglogo.png"
            alt="Scirocco Studio Logo"
            width="120"
            height="40"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="h-8 md:h-10 w-auto drop-shadow-2xl group-hover:scale-110 transition-all duration-300"
          />
          <div class="absolute inset-0 bg-white/20 blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>
        </div>
        <span class="font-playfair text-sm md:text-lg font-normal text-scirocco-wheat tracking-wide group-hover:text-scirocco-wheat/90 transition-colors duration-300">
          SCIROCCO STUDIO
        </span>
      </a>

      <div class="hidden md:flex items-center space-x-1">
        <a href="/#about" class="relative px-4 py-2 text-scirocco-wheat/85 hover:text-scirocco-wheat font-lora text-sm tracking-wide transition-all duration-300 group">
          <span class="relative z-10">About</span>
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-transparent via-white to-transparent group-hover:w-full transition-all duration-500" aria-hidden="true"></span>
        </a>
        <a href="/#materials" class="relative px-4 py-2 text-scirocco-wheat/85 hover:text-scirocco-wheat font-lora text-sm tracking-wide transition-all duration-300 group">
          <span class="relative z-10">Materials</span>
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-transparent via-white to-transparent group-hover:w-full transition-all duration-500" aria-hidden="true"></span>
        </a>
        <a href="/services" class="relative px-4 py-2 text-scirocco-wheat/85 hover:text-scirocco-wheat font-lora text-sm tracking-wide transition-all duration-300 group">
          <span class="relative z-10">Our Services</span>
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-transparent via-white to-transparent group-hover:w-full transition-all duration-500" aria-hidden="true"></span>
        </a>
        <a href="/our-curations" class="relative px-4 py-2 text-scirocco-wheat/85 hover:text-scirocco-wheat font-lora text-sm tracking-wide transition-all duration-300 group">
          <span class="relative z-10">Our Curations</span>
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-transparent via-white to-transparent group-hover:w-full transition-all duration-500" aria-hidden="true"></span>
        </a>
        <button type="button" data-open-inquiry class="relative ml-2 px-5 py-2.5 text-scirocco-wheat font-lora text-sm tracking-wide transition-all duration-300 rounded-full border border-white/30 hover:border-white/60 hover:bg-white/10 backdrop-blur-sm cursor-pointer">
          Contact
        </button>
      </div>

      <button id="menu-toggle" type="button" aria-controls="mobile-menu" class="md:hidden p-2.5 text-scirocco-wheat hover:bg-white/10 rounded-lg transition-all duration-300 backdrop-blur-sm border border-white/20" aria-label="Toggle mobile menu" aria-expanded="false">
        <svg class="w-6 h-6 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="fixed top-0 left-0 right-0 z-[90] bg-gradient-to-b from-scirocco-noam via-scirocco-noam/98 to-scirocco-noam/95 backdrop-blur-xl transform -translate-y-full transition-all duration-500 ease-out md:hidden shadow-2xl" role="navigation" aria-label="Mobile navigation">
    <div class="flex flex-col items-center pt-20 pb-8 space-y-6">
      <a href="/#about" class="text-scirocco-wheat/90 hover:text-scirocco-wheat font-lora text-lg tracking-wide transition-all duration-300 py-2 px-8 hover:bg-white/5 rounded-lg">About</a>
      <a href="/#materials" class="text-scirocco-wheat/90 hover:text-scirocco-wheat font-lora text-lg tracking-wide transition-all duration-300 py-2 px-8 hover:bg-white/5 rounded-lg">Materials</a>
      <a href="/services" class="text-scirocco-wheat/90 hover:text-scirocco-wheat font-lora text-lg tracking-wide transition-all duration-300 py-2 px-8 hover:bg-white/5 rounded-lg">Our Services</a>
      <a href="/our-curations" class="text-scirocco-wheat/90 hover:text-scirocco-wheat font-lora text-lg tracking-wide transition-all duration-300 py-2 px-8 hover:bg-white/5 rounded-lg">Our Curations</a>
      <button type="button" data-open-inquiry data-close-menu class="text-scirocco-wheat font-lora text-lg tracking-wide transition-all duration-300 py-2.5 px-8 border border-white/30 hover:border-white/60 hover:bg-white/10 rounded-full mt-2 cursor-pointer">Contact</button>
    </div>
  </div>

  <main id="main" class="relative z-0 flex-1">
    <slot />
  </main>

  <footer class:list={["text-scirocco-camel", hideFooter && "hidden"]} style="background: linear-gradient(180deg, #4A2511 0%, #5C2F18 30%, #5C2F18 100%); border-top: 1px solid rgba(168, 127, 102, 0.3);">
    <div class="max-w-7xl mx-auto px-8 py-8">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="flex items-center gap-4">
          <img
            src="/Scirocco-landinglogo.png"
            alt="Scirocco Studio Logo"
            width="120"
            height="40"
            loading="lazy"
            decoding="async"
            class="h-8 w-auto drop-shadow-lg"
          />
          <div>
            <span class="font-playfair text-base text-scirocco-ivory tracking-wide">SCIROCCO STUDIO S.R.L</span>
          </div>
        </div>
        <div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-6 text-sm">
          <span class="text-scirocco-desert">Rome · Dubai · Beirut</span>
          <span aria-hidden="true" class="hidden md:inline text-scirocco-desert">|</span>
          <a href="mailto:info@sciroccostudios.com" class="text-scirocco-desert underline underline-offset-4 decoration-scirocco-desert/50 hover:text-scirocco-ivory hover:decoration-scirocco-ivory transition-colors">info@sciroccostudios.com</a>
          <span aria-hidden="true" class="hidden md:inline text-scirocco-desert">|</span>
          <a href="https://www.instagram.com/sciroccostudios" target="_blank" rel="noopener noreferrer" class="text-scirocco-desert hover:text-scirocco-ivory transition-colors">@sciroccostudios</a>
        </div>
      </div>
      <div class="mt-6 pt-4 border-t border-scirocco-copper/20 flex flex-col md:flex-row md:items-center md:justify-between text-xs text-scirocco-desert">
        <p>&copy; 2026 Scirocco Studio. All rights reserved.</p>
        <p class="italic mt-1 md:mt-0">Every form begins with a current.</p>
      </div>
    </div>
  </footer>

  <!-- Global inquiry modal - triggers from nav Contact buttons and other CTAs -->
  <GlobalInquiryModal client:idle />

  <script>
    // Navigation and UI - Optimized for performance
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const navbar = document.getElementById('navbar');

    // Throttled scroll handler for better performance
    let ticking = false;
    let heroComplete = false;

    // Listen for hero animation completion
    window.addEventListener('heroAnimationComplete', () => {
      heroComplete = true;
      // Show navbar immediately when hero completes
      navbar?.classList.remove('opacity-0', 'invisible', 'pointer-events-none');
      navbar?.classList.add('opacity-100', 'pointer-events-auto');
    });

    // Immediately show navbar on non-homepage pages (no hero animation to wait for)
    if (window.location.pathname !== '/') {
      heroComplete = true;
      navbar?.classList.remove('opacity-0', 'invisible', 'pointer-events-none');
      navbar?.classList.add('opacity-100', 'pointer-events-auto');
    }

    // Show navbar immediately for hash navigation (hero will fast-complete)
    if (window.location.pathname === '/' && window.location.hash) {
      heroComplete = true;
      navbar?.classList.remove('opacity-0', 'invisible', 'pointer-events-none');
      navbar?.classList.add('opacity-100', 'pointer-events-auto');
    }

    const handleScroll = () => {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
      const navbarBg = navbar?.querySelector('.absolute.inset-0');

      // Show navbar when user scrolls (any amount > 0)
      if (scrollTop > 0) {
        navbar?.classList.remove('opacity-0', 'invisible', 'pointer-events-none');
        navbar?.classList.add('opacity-100', 'pointer-events-auto');
      } else if (!heroComplete) {
        // Only hide navbar when at top if hero animation hasn't completed
        navbar?.classList.add('opacity-0', 'invisible', 'pointer-events-none');
        navbar?.classList.remove('opacity-100', 'pointer-events-auto');
      }

      // Background darkening when scrolled past 50px
      if (scrollTop > 50) {
        navbarBg?.classList.remove('from-black/40', 'via-black/20');
        navbarBg?.classList.add('from-black/60', 'via-black/40', 'shadow-lg');
      } else {
        navbarBg?.classList.remove('from-black/60', 'via-black/40', 'shadow-lg');
        navbarBg?.classList.add('from-black/40', 'via-black/20');
      }

      ticking = false;
    };

    // Handle page loaded already scrolled (anchor links, page refresh)
    requestAnimationFrame(handleScroll);

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(handleScroll);
        ticking = true;
      }
    }, { passive: true });

    // Mobile menu. `inert` is what keeps the off-screen links out of the tab
    // order; translating alone leaves five focusable stops on every page.
    const setMenuOpen = (open: boolean) => {
      if (!mobileMenu) return;
      mobileMenu.classList.toggle('-translate-y-full', !open);
      mobileMenu.classList.toggle('translate-y-0', open);
      mobileMenu.inert = !open;
      menuToggle?.setAttribute('aria-expanded', String(open));
    };

    setMenuOpen(false);

    menuToggle?.addEventListener('click', () => {
      setMenuOpen(menuToggle.getAttribute('aria-expanded') !== 'true');
    });

    mobileMenu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => setMenuOpen(false));
    });

    // Contact buttons, wired by data attribute so no inline handler is needed
    // (inline handlers would require 'unsafe-inline' in the CSP).
    document.querySelectorAll('[data-open-inquiry]').forEach(btn => {
      btn.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('openInquiryModal', { detail: { mode: 'general' } }));
        if (btn.hasAttribute('data-close-menu')) setMenuOpen(false);
      });
    });

    // Fonts load non-blocking, then swap in. Replaces the inline onload.
    const fonts = document.getElementById('google-fonts') as HTMLLinkElement | null;
    if (fonts) {
      if (fonts.sheet) fonts.media = 'all';
      else fonts.addEventListener('load', () => { fonts.media = 'all'; }, { once: true });
    }

  </script>

</body>
</html>
