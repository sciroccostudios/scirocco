---
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="Page not found | Scirocco Studio"
  description="The page you were looking for could not be found."
>
  <section
    class="min-h-screen flex items-center justify-center px-6 py-32 text-center"
    style="background: linear-gradient(180deg, #5C2F18 0%, #6B4428 35%, #7A5C42 50%, #6B4428 65%, #4A2511 100%);"
  >
    <div class="max-w-xl mx-auto">
      <p class="font-lora text-xs tracking-[0.3em] uppercase text-scirocco-desert mb-6">
        Error 404
      </p>
      <h1 class="font-playfair text-4xl md:text-6xl text-scirocco-ivory mb-6" style="letter-spacing: 0.05em;">
        Page not found
      </h1>
      <p class="font-baskerville text-base md:text-lg text-scirocco-ivory mx-auto mb-10">
        This page may have moved, or the address may be mistyped.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-7 py-3 rounded-full bg-scirocco-ivory text-scirocco-noam font-lora text-sm tracking-wide hover:bg-white transition-colors duration-300"
        >
          Return home
        </a>
        <a
          href="/our-curations"
          class="inline-flex items-center gap-2 px-7 py-3 rounded-full border border-scirocco-ivory/70 text-scirocco-ivory font-lora text-sm tracking-wide hover:bg-white/10 transition-colors duration-300"
        >
          Browse Our Curations
        </a>
      </div>
    </div>
  </section>
</Layout>
