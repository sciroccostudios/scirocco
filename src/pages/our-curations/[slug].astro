---
import Layout from '@/layouts/Layout.astro';
import PDFViewer from '@/components/catalogue/PDFViewer';
import { edits, type Edit } from '@/data/edits';
import { DESERT_GRADIENT } from '@/lib/tokens';
import { editPdf, type EditPdf } from '@/lib/editPdf';

export function getStaticPaths() {
  return edits.map((edit) => ({
    params: { slug: edit.slug },
    props: { edit, pdf: editPdf(edit.pdfUrl) },
  }));
}

const { edit, pdf } = Astro.props as { edit: Edit; pdf: EditPdf };
---

<Layout
  title={`${edit.title} | The Scirocco Edit | Scirocco Studio`}
  description={`${edit.subtitle}. ${edit.monthLabel} edition of The Scirocco Edit, curated by Scirocco Studio.`}
  hideFooter
>
  <PDFViewer
    client:only="react"
    pdfUrl={pdf.url}
    pdfSize={pdf.size}
    title={edit.title}
    downloadFilename={edit.downloadFilename}
    backUrl="/our-curations"
    backLabel="Back to Our Curations"
  >
    <!--
      Static stand-in shown until the viewer's JavaScript runs. It matches the
      viewer's backdrop so a slow connection never sees a blank page.
    -->
    <section
      slot="fallback"
      class="relative w-full flex flex-col text-scirocco-wheat"
      style={`background: ${DESERT_GRADIENT}; height: 100svh;`}
    >
      <div class="px-3 sm:px-6 md:px-8 pt-20 md:pt-24 pb-2 md:pb-3">
        <a href="/our-curations" class="font-lora text-xs sm:text-sm text-scirocco-desert hover:text-scirocco-wheat transition-colors">
          ‹ Back to Our Curations
        </a>
      </div>
      <div class="flex-1 flex flex-col items-center justify-center gap-3">
        <div class="w-8 h-8 rounded-full border-2 border-white/25 border-t-scirocco-desert animate-spin"></div>
        <p class="font-lora text-sm text-scirocco-desert">Loading catalogue…</p>
      </div>
    </section>
  </PDFViewer>
</Layout>
